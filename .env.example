# ─────────────────────────────────────────────────────────────────────────────
# GoliTransit — backend service environment
#
# Copy to .env and run `php artisan key:generate`.
# The public site has its own env file: see frontend/.env.example.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# APP_NAME also becomes VITE_APP_NAME, which suffixes browser tab titles.
APP_NAME=GoliTransit
# local | production | testing
APP_ENV=local
# Generated by `php artisan key:generate`. Never commit a real key.
APP_KEY=
# Leave false in production: true exposes stack traces.
APP_DEBUG=true
# Must match the public origin. If it starts with https://, the app forces the
# https scheme when generating asset URLs (see AppServiceProvider).
APP_URL=http://localhost

# ── Logging ──────────────────────────────────────────────────────────────────
# Use "stderr" on serverless hosts, whose filesystem is read-only.
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
# GoliTransit's routing graph is held in code (app/Services/Graph/MapData.php),
# so no database is required to run, test, or deploy the app. These are kept for
# the default Laravel scaffolding only.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# ── Drivers ──────────────────────────────────────────────────────────────────
# IMPORTANT (Vercel): the deployed app runs with CACHE_DRIVER=array and
# SESSION_DRIVER=cookie because the serverless filesystem is read-only, and
# api/index.php additionally points every framework cache path at /tmp. Do not
# change those production values. "file" is correct for local and Docker.
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Set to true when serving over https so the session cookie is marked Secure.
# SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (unused by GoliTransit; Laravel scaffolding) ────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS (unused by GoliTransit; Laravel scaffolding) ─────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Broadcasting (unused by GoliTransit; Laravel scaffolding) ────────────────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ── Vite (backend Inertia bundle) ────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Routing engine tuning (config/golitransit.php) ───────────────────────────
# Cost added when the journey changes vehicle. Higher = fewer switches.
GOLITRANSIT_MODE_SWITCH_PENALTY=120
# Penalty applied when a lower-priority mode is chosen over a higher one.
GOLITRANSIT_MODE_PRIORITY_PENALTY=1000
# Distance (km) is multiplied by this to produce the integer route cost.
GOLITRANSIT_ROUTE_COST_SCALE=100

# Distance bands that decide which vehicle suits a leg.
# 0.0–0.8 km walk first, 0.8–1.8 km rickshaw first, above 1.8 km car first.
GOLITRANSIT_WALK_MAX_KM=0.8
GOLITRANSIT_RICKSHAW_MAX_KM=1.8
GOLITRANSIT_CAR_MIN_KM=1.8
# If the remaining trip is still longer than this, keep the car as the main
# corridor mode even when individual legs look short.
GOLITRANSIT_LONG_TRIP_CAR_PREFERENCE_KM=4.5

# Pause (microseconds) between calls in the sync commands, to stay inside the
# providers' free-tier rate limits. The test suite sets both to 0.
GOLITRANSIT_EXTERNAL_API_DELAY_US=100000
GOLITRANSIT_OSRM_API_DELAY_US=1000000

# ── External services ────────────────────────────────────────────────────────
# TomTom Routing/Traffic key, used server-side by TomTomService for the traffic
# sync command and cron job. The map itself renders with Leaflet + OpenStreetMap
# and needs no key. Leave blank to skip traffic sync.
TOMTOM_API_KEY=

# OSRM server used by `php artisan golitransit:sync-road-geometry-osrm` to fetch
# road-following polylines (cached to storage/app/road-geometry.json). The
# default is the public demo server: rate-limited and NOT for production.
OSRM_BASE_URL=https://router.project-osrm.org

# Shared secret authorising GET /api/internal/sync-traffic. Vercel Cron sends it
# automatically as `Authorization: Bearer $CRON_SECRET` when this is set.
# Without it the endpoint refuses to run.
CRON_SECRET=
